# Supabase (Project Settings > API). Leave blank to run the scraper in local-file mode (data/out).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for POST /api/scrape (Vercel cron / Atlas) and Bearer auth on the read API
SCRAPE_SECRET=
# Identify ourselves to vendor sites
SCRAPER_USER_AGENT=EmpreusCatalogBot/0.1 (+https://empreus.com.au; ag@empreus.com.au)
